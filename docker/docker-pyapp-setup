```bash
# Build image
docker build -t docker-demo .

# List images
docker images

# Run container
docker run -d -p 8000:8000 --name docker-demo-container docker-demo

# List running containers
docker ps

# List all containers
docker ps -a

# Test application
curl http://localhost:8000

# View logs
docker logs docker-demo-container

# Enter container
docker exec -it docker-demo-container bash

# Stop container
docker stop docker-demo-container

# Start container
docker start docker-demo-container

# Remove container
docker rm docker-demo-container

# Remove image
docker rmi docker-demo
```

